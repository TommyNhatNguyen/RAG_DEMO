EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B

CHROMA_PATH=./data/chroma
TEXT_COLLECTION=text_embeddings
VISUAL_COLLECTION=visual_embeddings
MANIFEST_PATH=./data/index_manifest.json
STORAGE_ROOT=./storage

OCR_ENGINE=tesseract
OCR_REQUIRED=false

VIDEO_SEGMENT_DURATION=30
VIDEO_FRAMES_PER_SEGMENT=3
VIDEO_COARSE_SAMPLE_INTERVAL=10
VIDEO_MAX_REPRESENTATIVE_FRAMES=3
VIDEO_FRAME_SIMILARITY_THRESHOLD=0.90
VIDEO_OCR_ENABLED=true
VIDEO_OCR_INTERVAL=30
VIDEO_SCENE_ENABLED=false
VIDEO_SCENE_THRESHOLD=27.0
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=vi
VIDEO_MAX_DURATION=

CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SIZE_PDF=350
CHUNK_OVERLAP_PDF=60
CHUNK_SIZE_DOCX=350
CHUNK_OVERLAP_DOCX=60
CHUNK_SIZE_PPTX=280
CHUNK_OVERLAP_PPTX=40
CHUNK_SIZE_TXT=500
CHUNK_OVERLAP_TXT=50

DEVICE=mps
TEXT_BATCH_SIZE=8
VL_BATCH_SIZE=1
RETRIEVER_K=5
GENERATION_K=8

LLM_MODEL=Qwen/Qwen3-1.7B
LLM_MAX_NEW_TOKENS=4096
LLM_ENABLE_THINKING=false
LLM_MAX_CONTEXT_CHARS=10000
LLM_DO_SAMPLE=false

VL_LLM_MODEL=Qwen/Qwen3-VL-2B-Instruct
VL_LLM_MAX_NEW_TOKENS=768
VL_MAX_IMAGES=3

QUERY_TASK=Given a learner question about an e-learning course (lectures, slides, transcripts, exercises, images, tables, formulas), retrieve relevant course materials that help answer with evidence

QUERY_ENHANCE=true
QUERY_ENHANCE_MAX_SUBQUERIES=3
QUERY_ENHANCE_MAX_NEW_TOKENS=256

RETRIEVER_FETCH_K=20
RETRIEVE_MAX_PER_FILE=2
COSINE_FALLBACK_THRESHOLD=0.15
HYBRID_SEARCH=true
BM25_PATH=./data/bm25.pkl
RERANK_ENABLED=false
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
CONTEXT_EXPAND=true
CONTEXT_COMPRESS=true
QUERY_HYDE=false
MAX_RETRIEVE_LOOPS=0

# Optional. Leave empty unless you need gated Hub models.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

GENERATE_PAGE_IMAGES=true
GENERATE_PICTURE_IMAGES=true
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=*
# Optional. If set, /v1/ask /v1/search /v1/stats require header X-API-Key.
API_KEY=
